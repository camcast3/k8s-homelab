# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# TF Generated Files
infrastructure/tfplan

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore log files
*.log

# Ansible generated files
ansible/secrets/
ansible/generated/
ansible/patches/
ansible/inventory/hosts.yml

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ansible vault
ansible/group_vars/all/vault.yml

# Ansible runtime files
.ansible/*

# Talos secrets
talos/test-config/controlplane.yaml
talos/test-config/talosconfig
talos/test-config/worker.yaml
talosconfig

# Kubeconfigs
*.kubeconfig
kubeconfig
talos/homelab-config/controlplane.yaml
talos/homelab-config/worker.yaml
ansible/vars/cluster_nodes.json
