machine:
  network:
    hostname: {{ item.inventory_hostname }}
    interfaces:
      - interface: ens18
        dhcp: false
        addresses:
          - {{ item.talos_static_ip }}/24
        routes:
          - network: 0.0.0.0/0
            gateway: {{ gateway }}
        vip:
          ip: {{ cluster_vip }}
    nameservers:
{% for ns in nameservers %}
      - {{ ns }}
{% endfor %}
  certSANs:
    - {{ cluster_vip }}
{% for host in groups['talos_control_plane'] %}
    - {{ hostvars[host].talos_static_ip }}
{% endfor %}

cluster:
  allowSchedulingOnControlPlanes: false
  network:
    cni:
      name: none
  proxy:
    disabled: true
