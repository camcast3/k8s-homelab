machine:
  network:
    hostname: {{ item.inventory_hostname }}
    interfaces:
      - interface: ens18
        dhcp: false
        addresses:
          - {{ item.talos_static_ip }}/24
        routes:
          - network: 0.0.0.0/0
            gateway: {{ gateway }}
    nameservers:
{% for ns in nameservers %}
      - {{ ns }}
{% endfor %}